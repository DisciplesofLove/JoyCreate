# LR7 — Arbitrum One mainnet address overrides (config-only cutover).
#
# After deploying the stack to Arbitrum One, copy the deployed addresses here
# (or into the app's runtime env) and restart. Each unset / empty value falls
# back to ZERO_ADDRESS, which keeps the chain's readiness predicate false.
# Read by src/config/env_address.ts (Vite renderer + Electron main).

# ERC-8004 registries (src/config/erc8004.ts)
VITE_IDENTITY_REGISTRY_ARB_ONE=
VITE_REPUTATION_REGISTRY_ARB_ONE=
VITE_VALIDATION_REGISTRY_ARB_ONE=

# Glue contracts (src/config/glue.ts)
VITE_STORE_REGISTRY_ARB_ONE=
VITE_EDITION_CONTROLLER_ARB_ONE=
VITE_AGENT_MANDATE_ARB_ONE=

# x402 rail (src/config/x402.ts) — Arb One USDC is already set in code
VITE_REVENUE_SPLITTER_ARB_ONE=
VITE_REGISTRATION_FEE_RECIPIENT_ARB_ONE=

# Data market (src/config/data_market.ts)
VITE_DATA_PROVENANCE_ARB_ONE=
VITE_DATA_LEASE_ARB_ONE=

# Optimistic staking (src/config/optimistic_staking.ts)
VITE_OPTIMISTIC_STAKING_ARB_ONE=

# Goldsky subgraphs redeployed against Arbitrum One (src/config/subgraphs.ts)
VITE_DROP_SUBGRAPH_ARB_ONE=
VITE_STORES_SUBGRAPH_ARB_ONE=
VITE_MARKETPLACE_SUBGRAPH_ARB_ONE=
